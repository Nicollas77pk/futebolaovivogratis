{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/api/canais",
      "dest": "/api/canais.js"
    },
    {
      "src": "/tv",
      "dest": "/tv.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
